# PostgreSQL connection string for the central database.
DATABASE_URL=postgres://user:password@localhost:5432/selfhostform_cloud

# Google Cloud OAuth client (Web application type). Create at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the single redirect URI registered on the Google OAuth client.
# This is a URL ON THIS SERVER, never on a user's machine.
GOOGLE_OAUTH_REDIRECT_URI=https://your-cloud-server.example.com/auth/google/callback

PORT=8787
