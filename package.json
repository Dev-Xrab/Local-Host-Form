{
  "name": "self-host-form",
  "private": true,
  "version": "1.2.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dev-Xrab/self-host-form-app.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web",
    "server": "node --watch server/index.js",
    "cloud-server": "node --watch --env-file=cloud-server/.env cloud-server/index.js",
    "build": "expo export -p web --output-dir dist",
    "start": "node server/index.js",
    "desktop": "electron electron/main.js",
    "predist": "node scripts/clear-dev-data.js",
    "dist": "npm run build && electron-builder",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "brand": "node scripts/generate-brand-assets.mjs",
    "pack:web-ui": "node scripts/pack-web-ui.mjs",
    "test:phone": "node mobile-server/test/ci.mjs",
    "test:drive": "node --test \"tests/server/*.test.mjs\""
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@noble/hashes": "^2.4.0",
    "@types/react": "~19.2.4",
    "buffer": "^6.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "exceljs": "^4.4.0",
    "expo": "^57.0.27",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.54.0",
    "oxlint": "^1.79.0",
    "png-to-ico": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.selfhostform.app",
    "productName": "Self Host Form",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/data/**",
      "package.json",
      "!node_modules/cloudflared/bin/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
