{
  "expo": {
    "name": "Self Host Form",
    "slug": "self-host-form",
    "scheme": "selfhostform",
    "version": "1.2.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#0D0E10"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "com.selfhostform.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0D0E10"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png",
      "backgroundColor": "#0D0E10"
    },
    "icon": "./assets/icon.png",
    "ios": {}
  }
}
